              "ContentFormula": {
                "Interpreter": 1,
                "Expression": "var now = Number($prop('DataCorePlugin.ExternalScript.DualMatrixTimeMs'));\nif (!(now > 0)) now = Date.now();\nvar date = new Date(now);\nvar value = date.getHours();\nvar digits = [[\"111\", \"101\", \"101\", \"101\", \"111\"], [\"010\", \"110\", \"010\", \"010\", \"111\"], [\"111\", \"001\", \"111\", \"100\", \"111\"], [\"111\", \"001\", \"111\", \"001\", \"111\"], [\"101\", \"101\", \"111\", \"001\", \"001\"], [\"111\", \"100\", \"111\", \"001\", \"111\"], [\"111\", \"100\", \"111\", \"101\", \"111\"], [\"111\", \"001\", \"010\", \"010\", \"010\"], [\"111\", \"101\", \"111\", \"101\", \"111\"], [\"111\", \"101\", \"111\", \"001\", \"111\"]];\nvar text = ('0' + value).slice(-2);\nvar result = [];\nfor (var i = 0; i < 64; i++) result.push('#FF000000');\nfor (var digit = 0; digit < 2; digit++) {\n    var glyph = digits[Number(text.charAt(digit))];\n    for (var row = 0; row < 5; row++) {\n        for (var col = 0; col < 3; col++) {\n            if (glyph[row].charAt(col) === '1')\n                result[(row + 1) * 8 + digit * 5 + col] = '#FFFFFFFF';\n        }\n    }\n}\nreturn result;"
